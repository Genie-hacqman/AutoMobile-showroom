# Application
APP_NAME=Obolo Motors API
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://showroom:showroom@localhost:5432/showroom

# Security
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Frontend URLs used inside emails
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_VERIFY_EMAIL_PATH=/verify-email
FRONTEND_RESET_PASSWORD_PATH=/reset-password

# SMTP email delivery. When SMTP_HOST is empty, emails are written to backend/app/static/emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@obolomotors.test
EMAIL_FROM_NAME=Obolo Motors

# First admin bootstrap (optional)
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
